{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {"type": "conicEqualArea", "rotate": [-132, 0], "parallels": [-18, -36]},
  "layer": [
    {
      "data": {"url": "data/australia_states.topojson", "format": {"type": "topojson", "feature": "states"}},
      "mark": {"type": "geoshape", "fill": "#e6e0dc", "stroke": "white"}
    },
    {
      "data": {"url": "data/australia_states.topojson", "format": {"type": "topojson", "feature": "states"}},
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "data/crush_by_state.csv", "format": {"type": "csv", "parse": {"tonnes": "number", "share_pct": "number"}}},
            "key": "state",
            "fields": ["tonnes", "share_pct"]
          }
        },
        {"filter": "datum.share_pct != null"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "title": "Share of national crush (%)",
          "scale": {
            "type": "threshold",
            "domain": [1, 5, 20, 50],
            "range": ["#f1dee1", "#e3b8bf", "#c98a96", "#a8505f", "#7b2d3b"]
          }
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "State"},
          {"field": "tonnes", "type": "quantitative", "title": "Tonnes crushed, 2023", "format": ",.0f"},
          {"field": "share_pct", "type": "quantitative", "title": "Share of national crush (%)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"values": [
        {"longitude": 135.0, "latitude": -30.0, "label": "South Australia\n55%", "color": "#ffffff"},
        {"longitude": 146.6, "latitude": -32.6, "label": "New South Wales\n27%", "color": "#ffffff"},
        {"longitude": 144.8, "latitude": -36.8, "label": "Victoria\n13%", "color": "#2b2226"},
        {"longitude": 122.0, "latitude": -26.0, "label": "Western Australia\n3.5%", "color": "#2b2226"},
        {"longitude": 144.5, "latitude": -22.5, "label": "Queensland\n0.04%", "color": "#2b2226"},
        {"longitude": 146.7, "latitude": -42.2, "label": "Tasmania\n0.9%", "color": "#2b2226"},
        {"longitude": 133.5, "latitude": -19.5, "label": "No wine grape data", "color": "#8a8280"}
      ]},
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "lineBreak": "\n", "align": "center", "baseline": "middle"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"},
        "color": {"field": "color", "type": "nominal", "scale": null, "legend": null}
      }
    }
  ],
  "resolve": {"scale": {"color": "independent"}}
}